{
  "name": "built-in functions (locale-independent)",
  "$comment": "ロケール依存の書式関数は format-advisory.json に分離してある。",
  "scope": {
    "data": {
      "s": "  Hello World  ",
      "arr": [3, 1, 2],
      "words": ["a", "b", "c"],
      "objs": [{ "id": "x" }, { "id": "y" }],
      "obj": { "a": { "b": 7 }, "z": null },
      "nil": null,
      "empty": ""
    },
    "state": {},
    "env": { "platform": "ios", "locale": "ja-JP", "appVersion": "3.14.0" }
  },
  "cases": [
    { "expr": "${len('abc')}", "expect": 3 },
    { "expr": "${len(data.arr)}", "expect": 3 },
    { "expr": "${len(data.obj)}", "expect": 2 },
    { "expr": "${len(data.nil)}", "expect": 0 },
    { "expr": "${count(data.words)}", "expect": 3 },

    { "expr": "${upper('abc')}", "expect": "ABC" },
    { "expr": "${lower('ABC')}", "expect": "abc" },
    { "expr": "${trim(data.s)}", "expect": "Hello World" },
    { "expr": "${contains('hello', 'ell')}", "expect": true },
    { "expr": "${contains('hello', 'xyz')}", "expect": false },
    { "expr": "${contains(data.words, 'b')}", "expect": true },
    { "expr": "${startsWith('hello', 'he')}", "expect": true },
    { "expr": "${endsWith('hello', 'lo')}", "expect": true },
    { "expr": "${join(data.words, '-')}", "expect": "a-b-c" },
    { "expr": "${join(data.arr, ',')}", "expect": "3,1,2" },
    { "expr": "${split('a,b,c', ',')}", "expect": ["a", "b", "c"] },
    { "expr": "${replace('a-b-a', 'a', 'X')}", "expect": "X-b-X" },
    { "expr": "${slice('abcdef', 1, 3)}", "expect": "bc" },
    { "expr": "${slice('abcdef', 2)}", "expect": "cdef" },
    { "expr": "${slice(data.arr, 0, 2)}", "expect": [3, 1] },
    { "expr": "${slice(data.arr, 10)}", "expect": [] },

    { "expr": "${min(3, 5)}", "expect": 3 },
    { "expr": "${max(3, 5)}", "expect": 5 },
    { "expr": "${abs(-4.5)}", "expect": 4.5 },
    { "expr": "${floor(4.9)}", "expect": 4 },
    { "expr": "${ceil(4.1)}", "expect": 5 },
    { "expr": "${floor(-4.1)}", "expect": -5 },
    { "expr": "${ceil(-4.9)}", "expect": -4 },

    { "$comment": "round は half-up (+∞方向)", "expr": "${round(4.5)}", "expect": 5 },
    { "expr": "${round(4.4)}", "expect": 4 },
    { "expr": "${round(-1.5)}", "expect": -1 },
    { "expr": "${round(-1.6)}", "expect": -2 },
    { "expr": "${round(1.2345, 2)}", "expect": 1.23 },
    { "expr": "${round(1.005, 1)}", "expect": 1 },

    { "expr": "${sum(data.arr)}", "expect": 6 },
    { "expr": "${sum([])}", "expect": 0 },
    { "expr": "${toNumber('42')}", "expect": 42 },
    { "expr": "${toNumber('4.5')}", "expect": 4.5 },
    { "expr": "${toNumber('abc')}", "expect": null },
    { "expr": "${toString(42)}", "expect": "42" },
    { "expr": "${toString(true)}", "expect": "true" },
    { "expr": "${toString(null)}", "expect": "" },

    { "expr": "${if(true, 'a', 'b')}", "expect": "a" },
    { "expr": "${if(data.empty, 'a', 'b')}", "expect": "b" },
    { "expr": "${coalesce(null, null, 'x')}", "expect": "x" },
    { "expr": "${coalesce(data.nil, 0)}", "expect": 0 },
    { "expr": "${coalesce(null, null)}", "expect": null },
    { "$comment": "default は null と「空」の両方を代替する", "expr": "${default(data.empty, 'なし')}", "expect": "なし" },
    { "expr": "${default(data.nil, 'なし')}", "expect": "なし" },
    { "expr": "${default('x', 'なし')}", "expect": "x" },
    { "expr": "${default(0, 9)}", "expect": 0 },

    { "expr": "${has(data.obj, 'a')}", "expect": true },
    { "expr": "${has(data.obj, 'nope')}", "expect": false },
    { "$comment": "has は値が null のキーでも存在すれば true", "expr": "${has(data.obj, 'z')}", "expect": true },
    { "expr": "${get(data, 'obj.a.b')}", "expect": 7 },
    { "expr": "${get(data, 'obj.nope.deep', 0)}", "expect": 0 },
    { "expr": "${get(data, 'obj.nope')}", "expect": null },

    { "expr": "${first(data.arr)}", "expect": 3 },
    { "expr": "${last(data.arr)}", "expect": 2 },
    { "expr": "${first([])}", "expect": null },
    { "expr": "${first(data.objs).id}", "expect": "x" },
    { "expr": "${indexOf(data.words, 'b')}", "expect": 1 },
    { "expr": "${indexOf(data.words, 'zz')}", "expect": -1 },

    { "expr": "${isPlatform('ios')}", "expect": true },
    { "expr": "${isPlatform('android')}", "expect": false },
    { "expr": "${versionAtLeast('3.0.0')}", "expect": true },
    { "expr": "${versionAtLeast('3.14.0')}", "expect": true },
    { "expr": "${versionAtLeast('3.14.1')}", "expect": false },
    { "expr": "${versionAtLeast('4.0')}", "expect": false },
    { "expr": "${versionAtLeast('3.9')}", "expect": true },

    { "$comment": "plural: # が数値に置換される。ja は常に other",
      "expr": "${plural(1, {\"one\": \"# item\", \"other\": \"# items\"})}", "expect": "1 items" },
    { "expr": "${plural(3, {\"other\": \"#件\"})}", "expect": "3件" },

    { "expr": "${unknownFunction(1)}", "expect": null, "error": "E_UNKNOWN_FN" },
    { "expr": "${len()}", "expect": null, "error": "E_TYPE" },
    { "expr": "${upper(42)}", "expect": null, "error": "E_TYPE" }
  ]
}
