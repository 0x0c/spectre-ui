{
  "name": "@spectre-ui/editor",
  "version": "0.1.0",
  "private": true,
  "description": "The M2 WYSIWYG editor (SU-0003): a manifest-driven, browser-based screen composer. React 19 + TypeScript + Vite, dnd-kit, Zustand + Immer, per ADR-0005.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@spectre-ui/manifest": "workspace:*",
    "immer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
