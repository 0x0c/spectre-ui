{
  "name": "spectre-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Spectre UI: a cross-platform library for server-driven user interfaces (SDUI). This root package only wires up the pnpm workspace under packages/ — see README.md.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node packages/codegen/generate.mjs",
    "generate:check": "node packages/codegen/generate.mjs --check",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
